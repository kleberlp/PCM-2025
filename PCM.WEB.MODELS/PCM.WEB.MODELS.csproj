<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fase 1 da migração (docs/MANUAL-MIGRACAO-DOTNET10-SEGURANCA.md):
       SDK-style multi-target. net48 continua servindo PCM.WEB/PCM.ADM.WEB;
       net9.0 destrava os consumidores migrados. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net9.0</TargetFrameworks>
    <RootNamespace>PCM.WEB.MODELS</RootNamespace>
    <AssemblyName>PCM.WEB.MODELS</AssemblyName>
    <!-- Os atributos continuam em Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

</Project>
