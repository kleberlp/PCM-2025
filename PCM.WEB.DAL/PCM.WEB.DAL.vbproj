<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fase 1 da migração (docs/MANUAL-MIGRACAO-DOTNET10-SEGURANCA.md):
       SDK-style multi-target. net48 continua servindo PCM.WEB/PCM.ADM.WEB
       e os serviços 4.8; net9.0 destrava os consumidores migrados.
       System.Data.SqlClient é mantido nesta fase — a troca por
       Microsoft.Data.SqlClient (Encrypt=True por padrão!) é passo próprio. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net9.0</TargetFrameworks>
    <RootNamespace>PCM.WEB.DAL</RootNamespace>
    <AssemblyName>PCM.WEB.DAL</AssemblyName>
    <MyType>Empty</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionCompare>Binary</OptionCompare>
    <OptionInfer>On</OptionInfer>
    <!-- Os atributos continuam em My Project\AssemblyInfo.vb -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Exigido pelos consumidores old-style (PCM.WEB/PCM.ADM.WEB, packages.config):
         o NuGet deles pede os assets do RID win a este projeto SDK-style -->
    <RuntimeIdentifiers>win</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Imports globais do projeto antigo (o SDK já traz os demais padrão) -->
  <ItemGroup>
    <Import Include="System.Data" />
  </ItemGroup>

  <!-- Designers do My Project: nada no código usa My.Settings/My.Resources;
       fora do compile para não colidir com a geração do SDK -->
  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
    <Compile Remove="My Project\Resources.Designer.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <EmbeddedResource Remove="My Project\Resources.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Oracle.ManagedDataAccess" Version="23.6.1" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.0" />
    <!-- Bitmap do Api.vb (thumbnail 400px); Windows-only em runtime, como todo consumidor da DAL -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.4" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.4" />
    <PackageReference Include="System.DirectoryServices" Version="9.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCM.WEB.MODELS\PCM.WEB.MODELS.csproj" />
  </ItemGroup>

</Project>
