<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- ============================================================
         Envio de e-mail (EmailSender.vb)

         Email:Provider = auto  -> usa Brevo se Email:ApiKey estiver
                                   preenchida; senão cai no SMTP
                          brevo -> força a API do Brevo
                          smtp  -> força o SMTP clássico

         Para migrar para o Brevo:
           1. Criar conta em https://www.brevo.com (300 e-mails/dia grátis)
           2. Verificar o domínio pcmbysim.com.br (SPF/DKIM no DNS)
           3. Gerar a chave em Settings > API Keys e colar abaixo
         ============================================================ -->
    <add key="Email:Provider" value="auto" />
    <add key="Email:ApiKey" value="" />
    <add key="Email:From" value="no-reply@pcmbysim.com.br" />
    <add key="Email:FromName" value="PCM by SIM" />

    <!-- SMTP de fallback (GoDaddy). A senha NÃO fica mais no código:
         preencher no App.config do servidor e TROCAR a senha antiga,
         que ficou exposta no histórico do repositório. -->
    <add key="Smtp:Host" value="smtpout.secureserver.net" />
    <add key="Smtp:Port" value="587" />
    <add key="Smtp:User" value="no-reply@pcmbysim.com.br" />
    <add key="Smtp:Password" value="" />
  </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Google.Apis.Auth" publicKeyToken="4b01fa6e34db77ab" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.49.0.0" newVersion="1.49.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Google.Apis" publicKeyToken="4b01fa6e34db77ab" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.49.0.0" newVersion="1.49.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Google.Apis.Core" publicKeyToken="4b01fa6e34db77ab" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.49.0.0" newVersion="1.49.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
