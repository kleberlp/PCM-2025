<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Envio de e-mail (EmailSender.vb): Provider auto usa Brevo se a
         ApiKey estiver preenchida, senão cai no SMTP (Smtp:* abaixo).
         Preencher chave/senha só no servidor; TROCAR a senha SMTP antiga,
         que ficou exposta no histórico do repositório. -->
    <add key="Email:Provider" value="auto" />
    <add key="Email:ApiKey" value="" />
    <add key="Email:From" value="no-reply@pcmbysim.com.br" />
    <add key="Email:FromName" value="PCM by SIM" />
    <add key="Smtp:Host" value="smtpout.secureserver.net" />
    <add key="Smtp:Port" value="587" />
    <add key="Smtp:User" value="no-reply@pcmbysim.com.br" />
    <add key="Smtp:Password" value="" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
</configuration>
