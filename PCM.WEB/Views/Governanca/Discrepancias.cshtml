        if (unidade.val() !== "") {
            unidade.trigger("change");
        }

        $('#btnApontarLimpeza').click(function () {

            $("#camareira").val("");

            $("#modCamareira").modal("show");

        });

        $('#btnClearApontamento').click(function () {

            clearApontamento();

        });

