    //---------------- Popup AD/Cr1/Cr2 ----------------
    var adcrCelulaAtual = null;
    var adcrSelected = { ad: null, cr1: null, cr2: null };

    function openADCrModal(celula) {

        adcrCelulaAtual = celula;
        adcrSelected = { ad: null, cr1: null, cr2: null };

        //Pré-seleciona os valores atuais da célula (formato "ad / cr1 / cr2")
        var partes = celula.text().split("/");
        var grupos = ["ad", "cr1", "cr2"];
        $(".adcr-num-btn").removeClass("selected");
        for (var i = 0; i < grupos.length; i++) {
            var v = parseInt((partes[i] || "").trim(), 10);
            if (!isNaN(v)) {
                adcrSelected[grupos[i]] = v;
                $(".adcr-btn-group[data-group='" + grupos[i] + "'] .adcr-num-btn").eq(v - 1).addClass("selected");
            }
        }

        $("#adcrModalOverlay").addClass("open");

    }

    function closeADCrModal() {
        adcrCelulaAtual = null;
        $("#adcrModalOverlay").removeClass("open");
    }

    function adcrSelect(grupo, valor, botao) {
        adcrSelected[grupo] = valor;
        $(botao).closest(".adcr-btn-group").find(".adcr-num-btn").removeClass("selected");
        $(botao).addClass("selected");
    }

    function saveADCrModal() {

        if (!adcrCelulaAtual) return;

        var apontamento = adcrCelulaAtual.data("apontamento");

        salvarDiscrepancia(apontamento, null, null, null, {
            adultos: adcrSelected.ad === null ? "" : adcrSelected.ad,
            criancas1: adcrSelected.cr1 === null ? "" : adcrSelected.cr1,
            criancas2: adcrSelected.cr2 === null ? "" : adcrSelected.cr2
        });

        adcrCelulaAtual.text(
            (adcrSelected.ad === null ? "--" : adcrSelected.ad) + " / " +
            (adcrSelected.cr1 === null ? "--" : adcrSelected.cr1) + " / " +
            (adcrSelected.cr2 === null ? "--" : adcrSelected.cr2)
        );

        closeADCrModal();

    }

    //---------------- Modal Camareira (Apontar Limpeza Realizada) ----------------
    $('#formCamareira').validate({
        ignore: [],
        errorClass: 'invalid-feedback animated fadeInDown',
        errorElement: 'div',
        errorPlacement: function (error, e) {
            jQuery(e).parents('.form-group > div').append(error);
        },
        highlight: function (e) {
            jQuery(e).closest('.form-group > div').removeClass('is-invalid').addClass('is-invalid');
        },
        success: function (e) {
            jQuery(e).closest('.form-group > div').removeClass('is-invalid');
            jQuery(e).remove();
        },
        rules: {
            'camareira': {
                required: true
            }
        },
        messages: {
            'camareira': {
                required: '@PCM.WEB.Properties.Resources.campo_requerido'
            }
        },
        submitHandler: function (form) {

            let codigosSelecionados = [];

            $("#tb_main input[type='checkbox']:checked").each(function () {
                let codigo = $(this).val();
                if (codigo && codigo !== "on") {
                    codigosSelecionados.push({
                        codigoApartamento: codigo.trim()
                    });
                }
            });

            if (codigosSelecionados.length === 0) {
                Swal.fire("Nenhuma UH selecionada!", "", "warning");
                return;
            }

            // Serializa o array em uma string JSON
            const jsonCodigos = JSON.stringify(codigosSelecionados);

            // Envia via Ajax como parâmetros
            $.ajax({
                url: "ApontamentoCamareira",
                type: "POST",
                data: {
                    unidade: $("#unidade").val(),
                    data: $("#data").val(),
                    camareira: $("#camareira").val(),
                    usuario: $("#usuario").val(),
                    json: jsonCodigos
                },
                success: function (response) {
                    Swal.fire("Sucesso!", response, "success");
                },
                error: function (xhr, status, error) {
                    Swal.fire("Erro!", "Erro ao salvar.", "error");
                    console.error(error);
                }
            });

            table.ajax.reload(null, false);
            $('#modCamareira').modal('hide');

            return false;

        }
    });

</script>
