@using System.Collections.Generic
@using System.Linq
@using PCM.WEB.MODELS
@{
    var camposDiscrepancia = (List<PCM.WEB.MODELS.GovernancaApontamentoDiscrepancia>)ViewBag.discrepancia ?? new List<PCM.WEB.MODELS.GovernancaApontamentoDiscrepancia>();
}
<!-- Main Container -->
<main id="main-container">

    <!-- Breadcrumb -->
    <div class="bg-body-light border-b">
        <div class="content py-0 text-md-center">
            <nav class="breadcrumb bg-body-light mb-0">
                <a class="breadcrumb-item font-w600" href="@Url.Action(Session["dashboard"].ToString(), "Home")">@PCM.WEB.Properties.Resources.sistema</a>
                <a class="breadcrumb-item">@PCM.WEB.Properties.Resources.governanca</a>
                <span class="breadcrumb-item active">Discrepâncias</span>
            </nav>
        </div>
    </div>
    <!-- END Breadcrumb -->
    <!-- Page Content -->
    <div class="content">

        @using (Html.BeginForm("Discrepancias", "Governanca", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "js-validation-bootstrap", role = "form", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <input type="hidden" id="codigo" name="codigo" value="" />

            <!-- Toggle Tasks Navigation on mobile -->
            <div class="block block-rounded border">
                <div class="block-header block-header-default bg-gd-default">
                    <h3 class="block-title text-white font-w600">Apontamento de Discrepâncias - @ViewBag.lastUpdate</h3>
                    <div class="block-options">
                        <button type="button" id="btnClearApontamento" name="btnClearApontamento" class="btn btn-square btn-secondary min-width-100 h-75 bg-danger-light">
                            <i class="fa fa-times mr-5"></i>Excluir apontamento
                        </button>
                        <button type="button" id="btnApontarLimpeza" name="btnApontarLimpeza" class="btn btn-square btn-secondary min-width-100 h-75">
                            <i class="fa fa-hotel mr-5"></i>Apontar Limpeza Realizada
                        </button>
                        <button type="button" id="btnApontarDivergencia" name="btnApontarDivergencia" class="btn btn-square btn-secondary min-width-100 h-75">
                            <i class="fa fa-exclamation-triangle mr-5"></i>Apontar Divergência
                        </button>
                    </div>
                </div>

            </div>
            <!-- END Collapsible Tasks Navigation -->

            <!-- Unidade vem do seletor do Header (sessão) -->
            <input type="hidden" name="usuario" id="usuario" value="@ViewBag.usuario" />
            <input type="hidden" name="unidade" id="unidade" value="@Session["codigo_unidade"]" />

            <!-- KPI Strip - Contadores de Discrepâncias -->
            <div class="os-kpi-strip">
                <div class="torre-comando-grid">

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-clipboard torre-icon" style="color:#42A5F5;"></i>
                            <span class="torre-label2">Total Planejado</span>
                        </div>
                        <span class="os-value" style="color:#374151;" id="kpiTotalPlanejado">0</span>
                        <span class="torre-meta">apartamentos com planejamento</span>
                    </div>

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-check-circle torre-icon" style="color:#6EAB4D;"></i>
                            <span class="torre-label2">Total Arrumado</span>
                        </div>
                        <span class="os-value" style="color:#374151;" id="kpiTotalArrumado">0</span>
                        <span class="torre-meta">com execução registrada</span>
                    </div>

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-bed torre-icon" style="color:#3F48CC;"></i>
                            <span class="torre-label2">Total Permanência</span>
                        </div>
                        <span class="os-value" style="color:#374151;" id="kpiTotalPermanencia">0</span>
                        <span class="torre-meta">limpeza planejada</span>
                    </div>

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-sign-out torre-icon" style="color:#EA580C;"></i>
                            <span class="torre-label2">Total Saída</span>
                        </div>
                        <span class="os-value" style="color:#374151;" id="kpiTotalSaida">0</span>
                        <span class="torre-meta">limpeza planejada</span>
                    </div>

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-ban torre-icon" style="color:#EF5350;"></i>
                            <span class="torre-label2">Não Perturbe / N.Q.A</span>
                        </div>
                        <span class="os-value" style="color:#EF5350;" id="kpiNaoPerturbe">0</span>
                        <span class="torre-meta" id="kpiNaoPerturbeMeta">-</span>
                    </div>

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-user torre-icon" style="color:#9CA3AF;"></i>
                            <span class="torre-label2">Saídas por Camareira</span>
                        </div>
                        <span class="os-value" style="color:#374151;" id="kpiSaidasCamareira">0</span>
                        <span class="torre-meta" id="kpiSaidasCamareiraMeta">-</span>
                    </div>

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-user torre-icon" style="color:#9CA3AF;"></i>
                            <span class="torre-label2">Permanências por Camareira</span>
                        </div>
                        <span class="os-value" style="color:#374151;" id="kpiPermanenciasCamareira">0</span>
                        <span class="torre-meta" id="kpiPermanenciasCamareiraMeta">-</span>
                    </div>

                    <div class="torre-item">
                        <div class="torre-header">
                            <i class="fa fa-eye torre-icon" style="color:#6EAB4D;"></i>
                            <span class="torre-label2">Saídas Vistoriadas</span>
                        </div>
                        <span class="os-value" style="color:#374151;" id="kpiSaidasVistoriadas">0</span>
                        <span class="torre-meta" id="kpiSaidasVistoriadasMeta">-</span>
                    </div>

                    <div class="torre-item" style="border-right:none;">
                        <div class="torre-header">
                            <i class="fa fa-percent torre-icon" style="color:#6EAB4D;"></i>
                            <span class="torre-label2">% Vistorias Saídas</span>
                        </div>
                        <span class="os-value" style="color:#6EAB4D;" id="kpiPctVistorias">0%</span>
                        <span class="torre-meta">saídas vistoriadas / total saídas</span>
                    </div>

                </div>
            </div>
            <!-- END KPI Strip -->

            <div class="block block-rounded border">

                <div class="block-content block-content-full">
                    <div class="form-group row">
                        <div class="col-md-2">
                            <label>@PCM.WEB.Properties.Resources.data</label>
                            <input type="text" class="js-datepicker form-control" id="data" name="data" data-week-start="1" data-autoclose="true" data-today-highlight="true" data-date-format="dd/mm/yyyy" placeholder="" value="@ViewBag.data">
                        </div>
                        <div class="col-md-1">
                            <label>@PCM.WEB.Properties.Resources.bloco</label>
                            @Html.DropDownList("bloco", null, "", new { @class = "js-select2 form-control" })
                        </div>
                        <div class="col-md-1">
                            <label>@PCM.WEB.Properties.Resources.andar</label>
                            @Html.DropDownList("andar", null, "", new { @class = "js-select2 form-control" })
                        </div>
                        <div class="col-md-2">
                            <label>U.H.</label>
                            <div class="input-group">
                                <input type="number" class="form-control text-center" id="uhInicio" name="uhInicio" placeholder="De">
                                <div class="input-group-prepend input-group-append">
                                    <span class="input-group-text font-w600">-</span>
                                </div>
                                <input type="number" class="form-control text-center" id="uhTermino" name="uhTermino" placeholder="Até">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label>Status Front Office</label>
                            @Html.DropDownList("frontOfficeStatus", null, "", new { @class = "js-select2 form-control" })
                        </div>
                        <div class="col-md-2">
                            <label>Status Quarto</label>
                            @Html.DropDownList("roomStatus", null, "", new { @class = "js-select2 form-control" })
                        </div>
                        <div class="col-md-2">
                            <label>Tipo de limpeza</label>
                            @Html.DropDownList("tipoGovernanca", null, "", new { @class = "js-select2 form-control" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive table-sm push block block-content-full p-10">
                <table class="table table-bordered table-hover js-dataTable-list" name="tbList" id="tb_main">

                    <thead>
                        <tr class="table-secondary">
                            <th class="text-md-center" style="width: 20px;" data-sortable="false"></th>
                            <th class="text-center">Local / U.H.</th>
                            <th class="text-center">Status Front Office</th>
                            <th class="text-center">Limpeza Planejada</th>
                            <th class="text-center">Dt Chegada</th>
                            <th class="text-center">Dt Saída</th>
                            <th class="text-center">Dias</th>
                            <th class="text-center">Planejado Para</th>
                            <th class="text-center">Executado Por</th>
                            <th class="text-center">Hora Término</th>
                            <th class="text-center">Vistoriado Por</th>
                            <th class="text-center">Stat. UH</th>
                            <th class="text-center">Stat. Gov</th>
                            <th class="text-center">Divergência</th>
                            <th class="text-center">AD/Cr1/Cr2</th>
                            <th class="text-center">Bagagem</th>
                            <th class="text-center">Observação</th>
                        </tr>
                    </thead>

                </table>
            </div>

            <!-- END Page Content -->
        }

    </div>

</main>
<!-- END Main Container -->
<!-- From Right Modal -->
<div class="modal fade" id="modCamareira" tabindex="-1" role="dialog" aria-labelledby="modCamareira" aria-hidden="true">
    @using (Html.BeginForm("ApontamentoCamareira", "Governanca", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form", @name = "formCamareira", @id = "formCamareira", enctype = "multipart/form-data" }))
    {
        <div class="modal-dialog modal-dialog-fromright" role="document">
            <div class="modal-content">
                <div class="block block-themed block-transparent">
                    <div class="block-header bg-gd-primary">
                        <h3 class="block-title text-white font-w600">@PCM.WEB.Properties.Resources.camareira</h3>
                    </div>
                </div>
                <div class="block-content">
                    <div class="form-group">
                        <div>
                            @Html.DropDownList("camareira", null, "", new { @class = "js-select2 form-control" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-square btn-secondary min-width-100 h-75" name="close" id="close" data-bs-dismiss="modal"><i class="fa fa-close mr-5"></i>@PCM.WEB.Properties.Resources.sair</button>
                    <button type="submit" class="btn btn-square btn-secondary min-width-100 h-75" name="btnSalveCamareira" id="btnSalveCamareira"><i class="fa fa-check mr-5"></i>@PCM.WEB.Properties.Resources.confirmado</button>
                </div>
            </div>
        </div>
    }
</div>
<!-- END From Right Modal -->

<!-- Popup AD/Cr1/Cr2 -->
<div class="adcr-modal-overlay" id="adcrModalOverlay">
    <div class="adcr-modal-box" style="position:relative;">
        <button type="button" class="adcr-close-btn" onclick="closeADCrModal()">&times;</button>
        <div class="adcr-modal-title">Insira a quantidade de hóspedes no apartamento</div>
        <div class="adcr-field">
            <label>Quantidade de Adultos:</label>
            <div class="adcr-btn-group" data-group="ad">
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('ad',1,this)">1</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('ad',2,this)">2</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('ad',3,this)">3</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('ad',4,this)">4</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('ad',5,this)">5</button>
            </div>
        </div>
        <div class="adcr-field">
            <label>Quantidade de Crianças tipo 1:</label>
            <div class="adcr-btn-group" data-group="cr1">
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr1',1,this)">1</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr1',2,this)">2</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr1',3,this)">3</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr1',4,this)">4</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr1',5,this)">5</button>
            </div>
        </div>
        <div class="adcr-field">
            <label>Quantidade de Crianças tipo 2:</label>
            <div class="adcr-btn-group" data-group="cr2">
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr2',1,this)">1</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr2',2,this)">2</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr2',3,this)">3</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr2',4,this)">4</button>
                <button type="button" class="adcr-num-btn" onclick="adcrSelect('cr2',5,this)">5</button>
            </div>
        </div>
        <div class="adcr-modal-footer">
            <button type="button" class="adcr-save-btn" onclick="saveADCrModal()">SALVAR</button>
        </div>
    </div>
</div>
<!-- END Popup AD/Cr1/Cr2 -->
@section Styles {
    @Styles.Render("~/Content/datepicker")
    @Styles.Render("~/Content/dataTables")
    @Styles.Render("~/Content/select")
    <style>
        /* Discrepâncias - destaques e controles */
        .discrepancia-divergente { background-color: #FFF3CD !important; }
        .select-center-text { text-align: center; text-align-last: center; -moz-text-align-last: center; }

        /* Combos Stat. UH / Stat. Gov / Divergência com padding interno reduzido */
        #tb_main select.disc-campo[data-campo="status_uh_discrepancia"],
        #tb_main select.disc-campo[data-campo="status_governanca_discrepancia"],
        #tb_main select.disc-campo[data-campo="discrepancia"] { padding: 1px 2px; }
        .adcr-cell { cursor: pointer; display: inline-block; min-width: 70px; padding: 3px 6px; border: 1px solid #D3D7DC; border-radius: 4px; background: #F5F6F7; font-size: 11px; }
        .adcr-cell:hover { background: #EAECEE; }
        .adcr-cell.disabled { cursor: not-allowed; opacity: .5; }

        .adcr-modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 10000; align-items: center; justify-content: center; }
        .adcr-modal-overlay.open { display: flex; }
        .adcr-modal-box { background: #fff; border-radius: 6px; width: 420px; max-width: 92vw; box-shadow: 0 10px 40px rgba(0,0,0,.25); padding: 22px 24px; }
        .adcr-modal-title { text-align: center; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 18px; }
        .adcr-field { margin-bottom: 16px; }
        .adcr-field label { display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px; }
        .adcr-btn-group { display: flex; gap: 6px; }
        .adcr-num-btn { width: 34px; height: 34px; border-radius: 4px; border: 1px solid #D3D7DC; background: #F5F6F7; color: #374151; font-size: 13px; cursor: pointer; }
        .adcr-num-btn:hover { background: #EAECEE; }
        .adcr-num-btn.selected { background: #0C80DF; border-color: #0C80DF; color: #fff; }
        .adcr-modal-footer { margin-top: 6px; }
        .adcr-save-btn { background: #0C80DF; color: #fff; border: none; border-radius: 4px; padding: 8px 22px; font-size: 12px; font-weight: 600; cursor: pointer; }
        .adcr-save-btn:hover { background: #0a6cbd; }
        .adcr-close-btn { position: absolute; top: 10px; right: 14px; background: none; border: none; font-size: 18px; color: #9CA3AF; cursor: pointer; }

        /* KPI Strip (padrão DesempenhoGovernanca) */
        .os-kpi-strip { background: #fff; border-radius: 14px; box-shadow: rgba(0,0,0,.06) 0 4px 14px; margin-bottom: 16px; overflow: hidden; }
        .torre-comando-grid { display: flex; flex-wrap: wrap; }
        .torre-item { flex: 1 1 90px; padding: 7px 10px; gap: 2px; border-right: 1px solid #F0F1F3; border-bottom: 1px solid #F0F1F3; transition: background .12s; position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
        .torre-item:hover { background: #F8F9FB; }
        .torre-header { display: flex; align-items: center; gap: 7px; margin-bottom: 2px; }
        .torre-icon { font-size: 13px; }
        .torre-label2 { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #6B7280; }
        .os-value { display: block; font-size: 18px; font-weight: 800; letter-spacing: -1px; line-height: 1; margin-bottom: 1px; }
        .torre-meta { font-size: 10px; color: #9CA3AF; display: block; }
    </style>
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/plugins/validation")
    @Scripts.Render("~/plugins/maxlenght")
    @Scripts.Render("~/plugins/datepicker")
    @Scripts.Render("~/plugins/select")

<script type="text/javascript" @Csp.NonceAttr>

    let selectedApartamentos = new Set();

    //Opções das combos de discrepância (tb_cad_discrepancia_gov -> procedure_lista)
    var opcoesDiscrepancia = {};
    @foreach (var campo in camposDiscrepancia)
    {
        if (campo.codigo_tipo_item_checklist == 10)
        {
            @:opcoesDiscrepancia["@campo.campo_apontamento"] = [
            foreach (var op in campo.opcoes)
            {
                @:{ codigo: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(op.codigo))", descricao: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(op.descricao))" },
            }
            @:];
        }
    }

    //Fallback quando a empresa não tem a combo cadastrada
    if (!opcoesDiscrepancia["discrepancia"] || !opcoesDiscrepancia["discrepancia"].length) {
        opcoesDiscrepancia["discrepancia"] = [{ codigo: "OK", descricao: "OK" }, { codigo: "N/OK", descricao: "N/OK" }];
    }
    if (!opcoesDiscrepancia["bagagem"] || !opcoesDiscrepancia["bagagem"].length) {
        opcoesDiscrepancia["bagagem"] = [{ codigo: "P", descricao: "P" }, { codigo: "M", descricao: "M" }, { codigo: "G", descricao: "G" }];
    }

    //Campo da tela -> parâmetro do SalvarDiscrepancia
    var mapaCampoParam = {
        "status_uh_discrepancia": "statusUh",
        "status_governanca_discrepancia": "statusGov",
        "discrepancia": "divergencia",
        "bagagem": "bagagem",
        "observacao": "observacao"
    };

    function descOpcao(campo, codigo) {
        var ops = opcoesDiscrepancia[campo] || [];
        for (var i = 0; i < ops.length; i++) {
            if (String(ops[i].codigo) === String(codigo)) return ops[i].descricao;
        }
        return "";
    }

    function renderSelectDiscrepancia(campo, valorAtual, row) {
        var ops = opcoesDiscrepancia[campo] || [];
        var disabled = (!row.codigoApontamento || row.codigoApontamento <= 0) ? " disabled title='U.H. sem apontamento'" : "";
        var html = "<select class='form-control form-control-sm select-center-text disc-campo' data-campo='" + campo + "' data-apontamento='" + row.codigoApontamento + "'" + disabled + "><option value=''></option>";
        for (var i = 0; i < ops.length; i++) {
            var sel = (String(ops[i].codigo) === String(valorAtual || "")) ? " selected" : "";
            html += "<option value=\"" + ops[i].codigo + "\"" + sel + ">" + ops[i].descricao + "</option>";
        }
        return html + "</select>";
    }

    function renderADCr(row) {
        var ad = row.adultos === "" ? "--" : row.adultos;
        var cr1 = row.criancas1 === "" ? "--" : row.criancas1;
        var cr2 = row.criancas2 === "" ? "--" : row.criancas2;
        var disabled = (!row.codigoApontamento || row.codigoApontamento <= 0);
        return "<span class='adcr-cell" + (disabled ? " disabled" : "") + "' data-apontamento='" + row.codigoApontamento + "' title='" + (disabled ? "U.H. sem apontamento" : "Clique para lançar quantidade de hóspedes") + "'>" + ad + " / " + cr1 + " / " + cr2 + "</span>";
    }

    $(window).on('resize', function () {
        if ($.fn.DataTable.isDataTable('#tb_main')) {
            table.columns.adjust().draw(false);
        }
    });

    $(document).on("change", "#tb_main input[type='checkbox']", function () {
        let codigo = $(this).val();

        if (!codigo || codigo === "on") return;

        if ($(this).is(":checked")) {
            selectedApartamentos.add(codigo);
        } else {
            selectedApartamentos.delete(codigo);
        }
    });

    //Grava o campo alterado (a SP mantém os demais valores via COALESCE)
    $(document).on("change", ".disc-campo", function () {
        var campo = $(this).data("campo");
        var apontamento = $(this).data("apontamento");
        var valor = $(this).val();
        salvarDiscrepancia(apontamento, mapaCampoParam[campo], valor, $(this));
    });

    $(document).on("change", ".disc-obs", function () {
        var apontamento = $(this).data("apontamento");
        salvarDiscrepancia(apontamento, "observacao", $(this).val(), $(this));
    });

    $(document).on("click", ".adcr-cell:not(.disabled)", function () {
        openADCrModal($(this));
    });

    function salvarDiscrepancia(codigoApontamento, parametro, valor, elemento, extras) {

        if (!codigoApontamento || codigoApontamento <= 0) return;

        var dados = {
            unidade: $("#unidade").val() == "" ? "-1" : $("#unidade").val(),
            codigoApontamento: codigoApontamento
        };

        if (parametro) { dados[parametro] = valor; }
        if (extras) { $.each(extras, function (k, v) { dados[k] = v; }); }

        $.ajax({
            url: "SalvarDiscrepancia",
            type: "POST",
            data: dados,
            success: function (response) {
                if (response !== "OK") {
                    Swal.fire("Atenção", response, "warning");
                }
            },
            error: function () {
                Swal.fire("Erro!", "Erro ao salvar a discrepância.", "error");
            }
        });

    }

    $(function () {

        // Initialize when page loads
        Codebase.helpers(['datepicker', 'maxlength', 'select2']);

        $.ajaxSetup({async: false});

        var unidade = $("#unidade");
        var tipoGovernanca = $("#tipoGovernanca");
        var data = $("#data");
        var camareira = $("#camareira");
        var bloco = $("#bloco");
        var andar = $("#andar");
        var roomStatus = $("#roomStatus");
        var frontOfficeStatus = $("#frontOfficeStatus");
        var uhInicio = $("#uhInicio");
        var uhTermino = $("#uhTermino");

        unidade.change(function () {

