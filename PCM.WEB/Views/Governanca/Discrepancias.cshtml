    function apontarDivergencia() {

        //Opção "N/OK" da combo de divergência
        var nok = "N/OK";
        var ops = opcoesDiscrepancia["discrepancia"] || [];
        for (var i = 0; i < ops.length; i++) {
            if (String(ops[i].codigo).toUpperCase() !== "OK") { nok = ops[i].codigo; break; }
        }

        let apontamentosSelecionados = [];

        table.rows().every(function () {
            let rowData = this.data();
            let node = this.node();

            let checkbox = $(node).find('input[type="checkbox"]');

            if (checkbox.prop('checked') === true && rowData.codigoApontamento > 0) {
                apontamentosSelecionados.push(rowData.codigoApontamento);
            }
        });

        if (apontamentosSelecionados.length === 0) {
            Swal.fire("Nenhuma U.H. com apontamento foi selecionada!", "", "warning");
            return;
        }

        Swal.fire({
            title: "PCM",
            html: "Deseja apontar divergência (" + nok + ") para as " + apontamentosSelecionados.length + " U.H. selecionadas?",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "@Html.Raw(PCM.WEB.Properties.Resources.sim)",
            cancelButtonText: "@Html.Raw(PCM.WEB.Properties.Resources.nao)",
        }).then((result) => {
            if (result.isConfirmed) {

                for (var i = 0; i < apontamentosSelecionados.length; i++) {
                    salvarDiscrepancia(apontamentosSelecionados[i], "divergencia", nok, null);
                }

                table.ajax.reload(null, false);

            }
        });

    }

    function clearApontamento() {

        let codigosSelecionados = [];

        table.rows().every(function () {
            let rowData = this.data();
            let node = this.node();

            let checkbox = $(node).find('input[type="checkbox"]');

            if (checkbox.prop('checked') === true && rowData.executadoPor !== "") {
                codigosSelecionados.push(rowData);
            }
        });

        if (codigosSelecionados.length === 0) {
            Swal.fire("Nenhuma U.H. válida foi Selecionada!", "", "warning");
            return;
        }

        // Serializa o array em uma string JSON
        const jsonCodigos = JSON.stringify(codigosSelecionados);

        Swal.fire({
            title: "PCM",
            html: "Deseja excluir o apontamento efetuado?",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "@Html.Raw(PCM.WEB.Properties.Resources.sim)",
            cancelButtonText: "@Html.Raw(PCM.WEB.Properties.Resources.nao)",
        }).then((result) => {
            /* Read more about isConfirmed, isDenied below */
            if (result) {

                jQuery.ajax({
                    type: "POST",
                    url: "ClearApontamento",
                    async: false,
                    data: {
                        unidade: $("#unidade").val(),
                        usuario: $("#usuario").val(),
                        data: $("#data").val(),
                        json: jsonCodigos
                    },
                    dataType: "json",
                    success: function (response) {
                        Swal.fire({
                            title: "@PCM.WEB.Properties.Resources.pcm",
                            html: response,
                            icon: "info",
                            showDenyButton: false,
                            showCancelButton: false,
                        }).then((result) => {
                            if (result) {
                                table.ajax.reload(null, false);
                            }
                        });
                    }
                });
            }
        });

    }

    function calcularKpis(rows) {

        var totalPlanejado = 0, totalArrumado = 0, totalPermanencia = 0, totalSaida = 0;
        var naoPerturbe = 0, nqa = 0, saidasVistoriadas = 0;
        var saidasPorCamareira = {}, permanenciasPorCamareira = {};

        $.each(rows, function (i, r) {

            var tipo = (r.tipoGovernanca || "").toUpperCase();
            var statusGovDesc = descOpcao("status_governanca_discrepancia", r.statusGov).toUpperCase();

            if (r.planejadoPara !== "") totalPlanejado++;
            if (r.executadoPor !== "") totalArrumado++;
            if (tipo.indexOf("PERMAN") === 0) totalPermanencia++;
            if (tipo.indexOf("SA") === 0) totalSaida++;
            if (statusGovDesc.indexOf("PERTURBE") >= 0) naoPerturbe++;
            if (statusGovDesc.indexOf("N.Q") >= 0) nqa++;

            if (tipo.indexOf("SA") === 0) {
                var cam = r.executadoPor !== "" ? r.executadoPor : "Pendente";
                saidasPorCamareira[cam] = (saidasPorCamareira[cam] || 0) + 1;
                if (r.vistoriadoPor !== "") saidasVistoriadas++;
            }

            if (tipo.indexOf("PERMAN") === 0) {
                var cam2 = r.executadoPor !== "" ? r.executadoPor : "Pendente";
                permanenciasPorCamareira[cam2] = (permanenciasPorCamareira[cam2] || 0) + 1;
            }

        });

        function metaPorCamareira(obj) {
            var partes = [];
            $.each(obj, function (nome, qtd) { partes.push(nome + ": " + qtd); });
            return partes.length ? partes.join(" · ") : "-";
        }

        $("#kpiTotalPlanejado").text(totalPlanejado);
        $("#kpiTotalArrumado").text(totalArrumado);
        $("#kpiTotalPermanencia").text(totalPermanencia);
        $("#kpiTotalSaida").text(totalSaida);
        $("#kpiNaoPerturbe").text(naoPerturbe + nqa);
        $("#kpiNaoPerturbeMeta").text(naoPerturbe + " Não Perturbe + " + nqa + " N.Q.A");
        $("#kpiSaidasCamareira").text(totalSaida);
        $("#kpiSaidasCamareiraMeta").text(metaPorCamareira(saidasPorCamareira));
        $("#kpiPermanenciasCamareira").text(totalPermanencia);
        $("#kpiPermanenciasCamareiraMeta").text(metaPorCamareira(permanenciasPorCamareira));
        $("#kpiSaidasVistoriadas").text(saidasVistoriadas);
        $("#kpiSaidasVistoriadasMeta").text("de " + totalSaida + " saídas planejadas");
        $("#kpiPctVistorias").text((totalSaida > 0 ? Math.round(saidasVistoriadas / totalSaida * 100) : 0) + "%");

    }

