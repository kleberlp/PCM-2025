@model List<PCM.WEB.MODELS.Governanca>
@functions {
    static string GovColor(string css)
    {
        css = (css ?? "").ToLower();
        if (css.Contains("danger")) return "gov-pend";
        if (css.Contains("success")) return "gov-ok";
        if (css.Contains("primary")) return "gov-lib";
        if (css.Contains("warning")) return "gov-ret";
        return "gov-vago";
    }
}

<!-- Main Container -->
<main id="main-container">

    <!-- Breadcrumb -->
    <div class="bg-body-light border-b">
        <div class="content py-0 text-center">
            <nav class="breadcrumb bg-body-light mb-0">
                <a class="breadcrumb-item font-w600" href="@Url.Action(Session["dashboard"].ToString(), "Home")">@PCM.WEB.Properties.Resources.sistema</a>
                <a class="breadcrumb-item">@PCM.WEB.Properties.Resources.governanca</a>
                <a class="breadcrumb-item" href="@Url.Action("ChecklistGovernanca", "Governanca")">@PCM.WEB.Properties.Resources.checklist</a>
            </nav>
        </div>
    </div>
    <!-- END Breadcrumb -->
    <!-- Page Content -->
    <div class="content">

        <!-- Toggle Tasks Navigation on mobile -->
        <div class="block block-rounded border">
            <div class="block-header block-header-default bg-gd-default">
                <h3 class="block-title text-white font-w600">@PCM.WEB.Properties.Resources.checklist - @ViewBag.lastUpdate</h3>
            </div>

            <div class="block-content block-content-full">
                <div class="form-group row">
                    <div class="col-md-3">
                        <label>@PCM.WEB.Properties.Resources.unidade</label>
                        @Html.DropDownList("unidade", null, "", new { @class = "js-select2 form-control" })
                    </div>
                    <div class="col-md-2">
                        <label>@PCM.WEB.Properties.Resources.tipoGovernanca</label>
                        @Html.DropDownList("tipoGovernanca", null, "", new { @class = "js-select2 form-control" })
                    </div>
                    <div class="col-md-2">
                        <label>Status Front office</label>
                        @Html.DropDownList("frontOfficeStatus", null, "", new { @class = "js-select2 form-control" })
                    </div>
                    <div class="col-md-2">
                        <label>Status Quarto</label>
                        @Html.DropDownList("roomStatus", null, "", new { @class = "js-select2 form-control" })
                    </div>
                    <div class="col-md-3">
                        <label>@PCM.WEB.Properties.Resources.funcionario</label>
                        @Html.DropDownList("funcionario", null, "", new { @class = "js-select2 form-control" })
                    </div>
                </div>
            </div>
        </div>
        <!-- END Collapsible Tasks Navigation -->

        <div class="gov-kpi">
            <a class="gov-kpi-t gov-pend" data-act="reloadPage" data-args='["1"]'>
                <div>
                    <div class="gov-kpi-n" data-speed="1000" data-to="@ViewBag.status.pendente" id="quantidade_indisponivel" name="quantidade_indisponivel">@ViewBag.status.pendente</div>
                    <div class="gov-kpi-l">@PCM.WEB.Properties.Resources.pendente</div>
                </div>
                <i class="fa fa-hotel gov-kpi-i d-none d-sm-block"></i>
            </a>
            <a class="gov-kpi-t gov-ok" data-act="reloadPage" data-args='["2"]'>
                <div>
                    <div class="gov-kpi-n" data-speed="1000" data-to="@ViewBag.status.concluido" id="quantidade_manutencao" name="quantidade_manutencao">@ViewBag.status.concluido</div>
                    <div class="gov-kpi-l">@PCM.WEB.Properties.Resources.concluido</div>
                </div>
                <i class="fa fa-hotel gov-kpi-i d-none d-sm-block"></i>
            </a>
            <a class="gov-kpi-t gov-lib" data-act="reloadPage" data-args='["3"]'>
                <div>
                    <div class="gov-kpi-n" data-speed="1000" data-to="@ViewBag.status.aguardandoLiberacao" id="quantidade_vistoria" name="quantidade_vistoria">@ViewBag.status.aguardandoLiberacao</div>
                    <div class="gov-kpi-l">@PCM.WEB.Properties.Resources.aguardando_liberacao</div>
                </div>
                <i class="fa fa-hotel gov-kpi-i d-none d-sm-block"></i>
            </a>
            <a class="gov-kpi-t gov-ret" data-act="reloadPage" data-args='["4"]'>
                <div>
                    <div class="gov-kpi-n"><span data-speed="1000" data-to="@ViewBag.status.retrabalho" id="quantidade_disponivel" name="quantidade_disponivel">@ViewBag.status.retrabalho</span></div>
                    <div class="gov-kpi-l">@PCM.WEB.Properties.Resources.retrabalho</div>
                </div>
                <i class="fa fa-hotel gov-kpi-i d-none d-sm-block"></i>
            </a>
        </div>


        <div class="block">

            <div class="block-header block-header-default bg-gd-default">
                <h3 class="block-title text-white font-w600">Lista de UH</h3>
                <div class="block-options">
                    <button type="button" class="si si-grid btn-block-option text-white" data-show="#div_grid" data-hide="#div_list"></button>
                    <button type="button" class="si si-list btn-block-option text-white" data-show="#div_list" data-hide="#div_grid"></button>
                    <button type="button" class="si si-printer btn-block-option text-white" data-act="Codebase.helpers" data-args='["print-page"]'></button>
                    <button type="button" class="btn-block-option text-white" data-toggle="block-option" data-action="fullscreen_toggle"></button>
                </div>
            </div>

            <div class="block-content" id="div_grid" style="display:block">
                <div class="gov-legend">
                    <b>Legenda:</b>
                    <span><i style="background:#EF5350"></i> Pendente</span>
                    <span><i style="background:#42A5F5"></i> Aguardando liberação</span>
                    <span><i style="background:#43A047"></i> Concluído</span>
                    <span><i style="background:#F59E0B"></i> Retrabalho</span>
                    <span><i style="background:#9CA3AF"></i> Sem apontamento</span>
                </div>
                @{
                    for (int i = 0; i < Model.Count; i++)
                    {
                        bool novoAndar = i == 0
                            || Model[i].unidade != Model[i - 1].unidade
                            || Model[i].bloco != Model[i - 1].bloco
                            || Model[i].andar != Model[i - 1].andar;

                        if (novoAndar)
                        {
                            if (i > 0)
                            {
                                @Html.Raw("</div>");
                            }

                            if (Session["unidade"] == "" && (i == 0 || Model[i].unidade != Model[i - 1].unidade))
                            {
                                <h5 class="gov-unidade">@PCM.WEB.Properties.Resources.unidade: <span class="text-primary">@Model[i].unidade</span></h5>
                            }

                            int cPend = 0, cOk = 0, cLib = 0, cRet = 0, cVago = 0;
                            for (int j = i; j < Model.Count
                                && Model[j].unidade == Model[i].unidade
                                && Model[j].bloco == Model[i].bloco
                                && Model[j].andar == Model[i].andar; j++)
                            {
                                switch (GovColor(Model[j].css_class))
                                {
                                    case "gov-pend": cPend++; break;
                                    case "gov-ok": cOk++; break;
                                    case "gov-lib": cLib++; break;
                                    case "gov-ret": cRet++; break;
                                    default: cVago++; break;
                                }
                            }

                            <div class="gov-floor">
                                <div class="gov-floor-name">@PCM.WEB.Properties.Resources.bloco @Model[i].bloco · @PCM.WEB.Properties.Resources.andar @Model[i].andar</div>
                                <div class="gov-floor-rule"></div>
                                <div class="gov-floor-counts">
                                    @if (cPend > 0) { <span class="gov-chip gov-pend"><i></i>@cPend pendente</span> }
                                    @if (cLib > 0) { <span class="gov-chip gov-lib"><i></i>@cLib aguardando</span> }
                                    @if (cOk > 0) { <span class="gov-chip gov-ok"><i></i>@cOk concluído</span> }
                                    @if (cRet > 0) { <span class="gov-chip gov-ret"><i></i>@cRet retrab.</span> }
                                    @if (cVago > 0) { <span class="gov-chip gov-vago"><i></i>@cVago s/ apont.</span> }
                                </div>
                            </div>

                            @Html.Raw("<div class='gov-rooms'>");
                        }

                        var metaFo = (Model[i].front_office_status ?? "").Trim();
                        var metaRs = (Model[i].room_status ?? "").Trim();
                        var metaTxt = metaFo + (metaRs == "" ? "" : (metaFo == "" ? "" : " · ") + metaRs);
                        var footTxt = string.IsNullOrEmpty(Model[i].data_proxima) ? "—" : Model[i].data_proxima;

                        if ((int)Model[i].status == 2)
                        {
                            <div class="gov-tile @GovColor(Model[i].css_class)">
                                <div class="gov-top">
                                    <span class="gov-num">@Model[i].apartamento</span>
                                    @if (Model[i].nao_perturbe)
                                    {
                                        <i class="fa fa-pause-circle-o gov-np" title="Não perturbe"></i>
                                    }
                                    <span class="gov-dot"></span>
                                </div>
                                <div class="gov-meta @(metaTxt == "" ? "gov-meta-empty" : "")">@(metaTxt == "" ? "—" : metaTxt)</div>
                                <div class="gov-foot"><i class="fa fa-clock-o"></i> @footTxt</div>
                            </div>
                        }
                        else if ((int)Model[i].status == 3)
                        {
                            <a class="gov-tile @GovColor(Model[i].css_class)" href="@Url.Action("ChecklistGovernancaVistoria", "Governanca", new { codigo_apartamento = @Model[i].codigo_apartamento, codigo_unidade = @Model[i].codigo_unidade, codigo_vistoria = @Model[i].codigo_vistoria, status = @Model[i].status, codigo_tipo_governanca = @Model[i].codigo_tipo_governanca , codigo_checklist = @Model[i].codigo_checklist })">
                                <div class="gov-top">
                                    <span class="gov-num">@Model[i].apartamento</span>
                                    @if (Model[i].nao_perturbe)
                                    {
                                        <i class="fa fa-pause-circle-o gov-np" title="Não perturbe"></i>
                                    }
                                    <span class="gov-dot"></span>
                                </div>
                                <div class="gov-meta @(metaTxt == "" ? "gov-meta-empty" : "")">@(metaTxt == "" ? "—" : metaTxt)</div>
                                <div class="gov-foot"><i class="fa fa-clock-o"></i> @footTxt</div>
                            </a>
                        }
                        else
                        {
                            <a class="gov-tile @GovColor(Model[i].css_class)" href="@Url.Action("ChecklistGovernancaApontamento", "Governanca", new { codigo_apartamento = @Model[i].codigo_apartamento, codigo_unidade = @Model[i].codigo_unidade, codigo_vistoria = @Model[i].codigo_vistoria, status = @Model[i].status, codigo_tipo_governanca = @Model[i].codigo_tipo_governanca , codigo_checklist = @Model[i].codigo_checklist })">
                                <div class="gov-top">
                                    <span class="gov-num">@Model[i].apartamento</span>
                                    @if (Model[i].nao_perturbe)
                                    {
                                        <i class="fa fa-pause-circle-o gov-np" title="Não perturbe"></i>
                                    }
                                    <span class="gov-dot"></span>
                                </div>
                                <div class="gov-meta @(metaTxt == "" ? "gov-meta-empty" : "")">@(metaTxt == "" ? "—" : metaTxt)</div>
                                <div class="gov-foot"><i class="fa fa-clock-o"></i> @footTxt</div>
                            </a>
                        }

                        if (i == (Model.Count - 1))
                        {
                            @Html.Raw("</div>");
                        }
                    }
                }

            </div>


            <div class="col-md-12 col-xl-12" id="div_list" style="display:none">

                <div class="block-content block-content-full">

                    <table class="table table-vcenter table-sm table-bordered table-hover js-dataTable-list">
                        <thead class="thead-pcm">
                            <tr>
                                @if (Session["unidade"] == "")
                                {
                                    <th class="d-none d-md-table-cell">@PCM.WEB.Properties.Resources.unidade</th>
                                }
                                <th class="text-center">@PCM.WEB.Properties.Resources.bloco</th>
                                <th class="text-center">@PCM.WEB.Properties.Resources.andar</th>
                                <th class="text-center">@PCM.WEB.Properties.Resources.apartamento</th>
                                <th class="text-center">@PCM.WEB.Properties.Resources.data_proxima_vistoria</th>
                                <th class="text-center">Status UH</th>
								<th class="text-center">@PCM.WEB.Properties.Resources.status_uh</th>
                                <th data-sortable="false" class="text-center d-print-none" style="width: 80px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @if (Session["unidade"] == "")
                                    {
                                        <td class="d-none d-md-table-cell">@Html.DisplayFor(modelItem => item.unidade)</td>
                                    }
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.bloco)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.andar)</td>
                                    <td class="text-center @item.css_class">@Html.DisplayFor(modelItem => item.apartamento)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.data_proxima)</td>
									<td class="text-center">@Html.DisplayFor(modelItem => item.front_office_status)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.room_status)</td>
                                    <td class="text-center d-print-none" style="width: 80px;">
                                        <div class="btn-group">
                                            @if ((item.status != 3))
                                            {<a href="@Url.Action("ChecklistUHApontamento", "UH", new { codigo_apartamento = @item.codigo_apartamento, codigo_unidade = @item.codigo_unidade, codigo_vistoria = @item.codigo_vistoria, status = @item.status })" class="btn btn-sm btn-secondary"><i class="fa fa-hotel"></i></a>}
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>
        <!-- END Page Content -->
</main>
<!-- END Main Container -->


@section Styles {
    @Styles.Render("~/Content/datepicker")
    @Styles.Render("~/Content/dataTables")
    @Styles.Render("~/Content/select")
    <style>
        /* Cores por status */
        .gov-pend { --c:#EF5350; --bg:#FEF2F2; }
        .gov-ok   { --c:#43A047; --bg:#F1FBF3; }
        .gov-lib  { --c:#42A5F5; --bg:#EFF7FF; }
        .gov-ret  { --c:#F59E0B; --bg:#FEF9EF; }
        .gov-vago { --c:#9CA3AF; --bg:#F8F9FB; }

        /* KPIs */
        .gov-kpi { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:16px; }
        @@media (max-width:767px) { .gov-kpi { grid-template-columns:repeat(2,1fr); } }
        .gov-kpi-t { background:#fff; border:1px solid #E9ECEF; border-radius:12px; padding:14px 16px; display:flex; align-items:center; gap:14px; box-shadow:0 1px 3px rgba(0,0,0,.04); cursor:pointer; transition:.12s; position:relative; overflow:hidden; color:inherit; }
        .gov-kpi-t:hover { transform:translateY(-1px); box-shadow:0 4px 12px rgba(0,0,0,.07); text-decoration:none; color:inherit; }
        .gov-kpi-t::before { content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--c); }
        .gov-kpi-n { font-size:26px; font-weight:800; line-height:1; color:var(--c); letter-spacing:-1px; }
        .gov-kpi-n span { color:var(--c); }
        .gov-kpi-l { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#6B7280; margin-top:4px; }
        .gov-kpi-i { margin-left:auto; font-size:20px; color:var(--c); opacity:.85; }

        /* Legenda */
        .gov-legend { display:flex; gap:16px; flex-wrap:wrap; align-items:center; padding:10px 4px 2px; font-size:11.5px; color:#6B7280; }
        .gov-legend b { color:#374151; font-weight:700; }
        .gov-legend span { display:inline-flex; align-items:center; gap:6px; font-weight:600; }
        .gov-legend i { width:11px; height:11px; border-radius:3px; display:inline-block; }

        /* Cabeçalho de andar */
        #div_grid .gov-unidade { font-size:14px; font-weight:800; color:#1E3A5F; margin:22px 4px 0; }
        #div_grid .gov-floor { display:flex; align-items:center; gap:14px; margin:18px 4px 10px; }
        #div_grid .gov-floor-name { font-size:13px; font-weight:800; color:#1E3A5F; white-space:nowrap; }
        #div_grid .gov-floor-rule { flex:1; height:1px; background:#E5E8EC; }
        #div_grid .gov-floor-counts { display:flex; gap:6px; flex-wrap:wrap; }
        #div_grid .gov-chip { font-size:10.5px; font-weight:700; padding:2px 9px; border-radius:999px; display:inline-flex; align-items:center; gap:5px; background:var(--bg); color:var(--c); }
        #div_grid .gov-chip i { width:7px; height:7px; border-radius:50%; background:var(--c); display:inline-block; }

        /* Grade de quartos */
        #div_grid .gov-rooms { display:grid; grid-template-columns:repeat(auto-fill, minmax(132px, 1fr)); gap:12px; }
        #div_grid .gov-tile { background:var(--bg); border:1px solid #EBEEF2; border-left:4px solid var(--c); border-radius:10px; padding:11px 12px 10px; min-height:92px; display:flex; flex-direction:column; gap:5px; color:inherit; text-decoration:none; transition:transform .12s, box-shadow .12s; }
        #div_grid a.gov-tile:hover { transform:translateY(-2px); box-shadow:0 6px 16px rgba(0,0,0,.08); border-color:var(--c); color:inherit; }
        #div_grid .gov-top { display:flex; align-items:center; gap:6px; }
        #div_grid .gov-num { font-size:19px; font-weight:800; letter-spacing:-.5px; color:#1F2937; line-height:1; }
        #div_grid .gov-np { margin-left:auto; color:#EF5350; font-size:13px; }
        #div_grid .gov-dot { margin-left:auto; width:12px; height:12px; border-radius:50%; background:var(--c); box-shadow:0 0 0 3px var(--bg); flex:none; }
        #div_grid .gov-np + .gov-dot { margin-left:0; }
        #div_grid .gov-meta { font-size:11px; font-weight:600; color:#6B7280; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        #div_grid .gov-meta-empty { color:#B4BAC2; }
        #div_grid .gov-foot { margin-top:auto; font-size:10px; color:#9CA3AF; }
        #div_grid .gov-foot .fa { margin-right:4px; }
    </style>
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/plugins/validation")
    @Scripts.Render("~/plugins/maxlenght")
    @Scripts.Render("~/plugins/datepicker")
    @Scripts.Render("~/plugins/select")

<script type="text/javascript" @Csp.NonceAttr>

    $(function () {

        $.ajaxSetup({async: false});

        $("#unidade").change(function () {
            reloadPage("@ViewBag.status");
        });

        $("#tipoGovernanca").change(function () {
            reloadPage("@ViewBag.status");
        });

        $("#funcionario").change(function () {
            reloadPage("@ViewBag.status");
        });

        $("#frontOfficeStatus").change(function () {
            reloadPage("@ViewBag.status");
        });

        $("#roomStatus").change(function () {
            reloadPage("@ViewBag.status");
        });

    });

    function reloadPage(status) {

        valorUnidade = $("#unidade").val() != "" ? $("#unidade").val() : "-1";
        valorTipoGovernanca = $("#tipoGovernanca").val() != "" ? $("#tipoGovernanca").val() : "-1";
        valorFuncionario = $("#funcionario").val() != "" ? $("#funcionario").val() : "-1";
        frontOfficeStatus = $("#frontOfficeStatus").val() != "" ? $("#frontOfficeStatus").val() : "";
        roomStatus = $("#roomStatus").val() != "" ? $("#roomStatus").val() : "";

        window.open("../Governanca/ChecklistGovernanca?unidade=" + valorUnidade + "&funcionario=" + valorFuncionario + "&tipoGovernanca=" + valorTipoGovernanca + "&status=" + @ViewBag.statusFilter + "&frontOfficeStatus=" + frontOfficeStatus + "&roomStatus=" + roomStatus, "_self");
    }

</script>
}
