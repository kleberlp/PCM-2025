@model IEnumerable<PCM.WEB.MODELS.ManualGrid>

<!-- Main Container -->
<main id="main-container">

    <!-- Breadcrumb -->
    <div class="bg-body-light border-b">
        <div class="content py-0 text-md-center">
            <nav class="breadcrumb bg-body-light mb-0">
                <a class="breadcrumb-item font-w600" href="@Url.Action(Session["dashboard"].ToString(), "Home")">@PCM.WEB.Properties.Resources.sistema</a>
                <span class="breadcrumb-item active">@PCM.WEB.Properties.Resources.manual</span>
            </nav>
        </div>
    </div>
    <!-- END Breadcrumb -->

    <!-- Page Content -->
    <div class="content">

        <!-- Listagem -->
        <div class="block block-rounded border">

            <div class="block-header block-header-default bg-gd-default">
                <h3 class="block-title text-white font-w600">@PCM.WEB.Properties.Resources.manual</h3>
                @if (ViewBag.inserir)
                {
                    <div class="block-options">
                        <a href="@Url.Action("HelpInsert", "Manual")" class="btn btn-square btn-secondary min-width-100 h-75">
                            <i class="fa fa-save mr-5"></i>@PCM.WEB.Properties.Resources.novo
                        </a>
                    </div>
                }
            </div>

            <div class="block-content block-content-full">

                <table class="table table-sm table-vcenter table-striped js-dataTable-list">

                    <thead>
                        <tr class="table-secondary">
                            <th>@PCM.WEB.Properties.Resources.titulo</th>
                            <th class="d-none d-sm-table-cell" style="width: 110px;"></th>
                            <th class="d-none d-sm-table-cell">@PCM.WEB.Properties.Resources.manual_tela / @PCM.WEB.Properties.Resources.manual_processo</th>
                            <th class="d-none d-sm-table-cell text-md-center" style="width: 90px;">@PCM.WEB.Properties.Resources.manual_secoes</th>
                            <th class="d-none d-sm-table-cell text-md-center" style="width: 80px;">@PCM.WEB.Properties.Resources.ativo</th>
                            @if (ViewBag.editar || ViewBag.excluir)
                            {
                                <th class="text-md-center" style="width: 80px;" data-sortable="false"></th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.titulo
                                    @if (!string.IsNullOrEmpty(item.subtitulo))
                                    {
                                        <div class="text-muted font-size-sm">@item.subtitulo</div>
                                    }
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    @if (item.tipo == "P")
                                    {
                                        <span class="badge badge-info">@PCM.WEB.Properties.Resources.manual_processo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">@PCM.WEB.Properties.Resources.manual_tela</span>
                                    }
                                </td>
                                <td class="d-none d-sm-table-cell">@item.tela</td>
                                <td class="d-none d-sm-table-cell text-md-center">@item.secoes</td>
                                <td class="d-none d-sm-table-cell text-md-center">@(item.ativo ? PCM.WEB.Properties.Resources.sim : PCM.WEB.Properties.Resources.nao)</td>
                                @if (ViewBag.editar || ViewBag.excluir)
                                {
                                    <td class="text-md-center">
                                        <div class="btn-group">
                                            @if (ViewBag.editar)
                                            {
                                                <a href="@Url.Action("HelpEdit", "Manual", new { codigo = item.codigo })" class="btn btn-sm btn-secondary" title="@PCM.WEB.Properties.Resources.editar"><i class="fa fa-pencil"></i></a>
                                            }
                                            @if (ViewBag.excluir)
                                            {
                                                <button type="button" class="btn btn-sm btn-secondary js-manual-excluir" data-codigo="@item.codigo" title="@PCM.WEB.Properties.Resources.excluir"><i class="fa fa-times"></i></button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>
    <!-- END Page Content -->
</main>
<!-- END Main Container -->

@section Styles {
    @Styles.Render("~/Content/dataTables")
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")

    <script type="text/javascript" @Csp.NonceAttr>

        var BeTableDatatables = function () {
            var exDataTable = function () {
                jQuery.extend(jQuery.fn.dataTable.ext.classes, {
                    sWrapper: "dataTables_wrapper dt-bootstrap4"
                });
            };

            var initDataTableSimple = function () {
                jQuery('.js-dataTable-list').dataTable({
                    fixedHeader: true,
                    searching: true,
                    lengthChange: false,
                    pageLength: 15,
                    autoWidth: false,
                    scrollX: false,
                    dom: 'Bfrtip',
                    buttons: [
                        { extend: 'copy', text: 'Copiar' },
                        { extend: 'print', text: 'Imprimir' },
                        { extend: 'excel' },
                        { extend: 'pdf', orientation: 'portrait' },
                    ],
                    language: {
                        "search": "Procurar:",
                        "lengthMenu": "Exibir _MENU_ ",
                        "zeroRecords": "Nenhum Registro Encontrado",
                        "info": "_MAX_ registro(s)",
                        "infoEmpty": "Nenhum Registro encontrado",
                        "infoFiltered": "(filtrado de _MAX_ registro(s))"
                    }
                });
            };

            return {
                init: function () {
                    exDataTable();
                    initDataTableSimple();
                }
            };
        }();

        jQuery(function () {

            BeTableDatatables.init();

            // Excluir com confirmação: o manual não tem tela de delete própria —
            // a exclusão é rara e a confirmação do SweetAlert basta.
            jQuery(document).on('click', '.js-manual-excluir', function () {

                var codigo = jQuery(this).data('codigo');

                Swal.fire({
                    text: '@PCM.WEB.Properties.Resources.deseja_excluir',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: '@PCM.WEB.Properties.Resources.sim',
                    cancelButtonText: '@PCM.WEB.Properties.Resources.nao'
                }).then(function (r) {

                    if (!r.isConfirmed) return;

                    jQuery.ajax({
                        url: '@Url.Action("DeleteHelp", "Manual")',
                        type: 'POST',
                        data: { codigo: codigo },
                        success: function (res) {
                            if (res.success) { window.location.reload(); }
                            else { Swal.fire({ text: res.message, icon: 'error' }); }
                        },
                        error: function () {
                            Swal.fire({ text: 'Não foi possível excluir o manual.', icon: 'error' });
                        }
                    });

                });

            });

        });

    </script>
}
