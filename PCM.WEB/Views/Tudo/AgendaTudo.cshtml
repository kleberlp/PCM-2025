@using PCM.WEB.Properties
@using Newtonsoft.Json

@{
    var kpi = (PCM.WEB.MODELS.TudoAgendaKpi)ViewBag.kpi;
}

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/Content/css/pcm-ui.css">
    @Styles.Render("~/Content/select")
    @Styles.Render("~/Content/fullcalendar")
    <style>
        #tudo-calendar { --fc-border-color: var(--pcm-line, #E5E7EB); font-size: 12px; }
        #tudo-calendar .fc-toolbar-title { font-size: 16px; font-weight: 800; }
        #tudo-calendar .fc-daygrid-day.fc-day-today { background: #F2F6FF; }
        #tudo-calendar .fc-event { cursor: pointer; border: none; padding: 1px 4px; font-weight: 600; }
        #tudo-calendar .fc-daygrid-event { white-space: normal; }
        .ag-plan { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; padding: 14px 18px; }
        .ag-plan label { display: block; font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--pcm-muted, #9aa0a6); margin-bottom: 4px; }
    </style>
}

<main id="main-container">

    <div class="bg-body-light border-b">
        <div class="content py-0 text-center">
            <nav class="breadcrumb bg-body-light mb-0">
                <a class="breadcrumb-item font-w600" href="@Url.Action(Session["dashboard"].ToString(), "Home")">@Resources.sistema</a>
                <a class="breadcrumb-item" href="@Url.Action("ChecklistTudo", "Tudo")">@Resources.tudo_em_dia</a>
                <span class="breadcrumb-item active">@Resources.agenda</span>
            </nav>
        </div>
    </div>

    <div class="content">

        <div class="pcm-page-header">
            <div>
                <h1><i class="fa fa-calendar-check-o"></i>@Resources.agenda — @Resources.tudo_em_dia</h1>
                <div class="pcm-sub">Calendário de execuções e auto-planejamento por responsável</div>
            </div>
            <div class="pcm-filter" id="filtro">
                @Html.DropDownList("unidade", (SelectList)ViewBag.unidade, new { @class = "pcm-select", id = "unidade" })
                @Html.DropDownList("funcionario", (SelectList)ViewBag.funcionario, Resources.responsavel, new { @class = "pcm-select", id = "funcionario" })
            </div>
        </div>

        <!-- KPIs -->
        <div class="pcm-kpi">
            <div class="pcm-torre c-pendente">
                <div class="pcm-torre-h"><span class="pcm-dot"></span><span class="pcm-torre-lb">@Resources.planejados</span></div>
                <div class="pcm-torre-val" id="kpiPlanejados">@kpi.planejados</div>
            </div>
            <div class="pcm-torre c-atrasado">
                <div class="pcm-torre-h"><span class="pcm-dot"></span><span class="pcm-torre-lb">@Resources.atrasados</span></div>
                <div class="pcm-torre-val" id="kpiAtrasados">@kpi.atrasados</div>
            </div>
            <div class="pcm-torre c-manut">
                <div class="pcm-torre-h"><span class="pcm-dot"></span><span class="pcm-torre-lb">@Resources.para_hoje</span></div>
                <div class="pcm-torre-val" id="kpiHoje">@kpi.hoje</div>
            </div>
            <div class="pcm-torre c-ok">
                <div class="pcm-torre-h"><span class="pcm-dot"></span><span class="pcm-torre-lb">@Resources.concluidos</span></div>
                <div class="pcm-torre-val" id="kpiConcluidos">@kpi.concluidos</div>
            </div>
        </div>

        <!-- Ações de planejamento -->
        @if (ViewBag.inserir)
        {
            <div class="pcm-card">
                <div class="ag-plan">
                    <div>
                        <label>@Resources.capacidade</label>
                        <input type="number" id="capacidade" value="0" min="0" class="pcm-select u-w-130" title="0 = distribui a demanda do mês pelos dias disponíveis" />
                    </div>
                    <button type="button" id="gerar" class="btn-pcm btn-pcm-dark"><i class="fa fa-magic"></i> @Resources.gerar_planejamento</button>
                    @if (ViewBag.excluir)
                    {
                        <button type="button" id="limpar" class="btn-pcm btn-pcm-ghost"><i class="fa fa-eraser"></i> @Resources.limpar</button>
                    }
                    <span class="pcm-sub" style="margin-left:auto;">Gera para o mês exibido no calendário: pega tudo que falta, divide pelos dias e distribui por responsável sem estourar o vencimento. <b>Capacidade 0 = automático.</b></span>
                </div>
            </div>
        }

        <!-- Calendário -->
        <div class="pcm-card">
            <div class="block-content block-content-full">
                <div id="tudo-calendar"></div>
            </div>
        </div>

    </div>
</main>

@Html.AntiForgeryToken()

<div id="resource-messages"
     data-messages='@Html.Raw(JsonConvert.SerializeObject(new
    {
        gerarOk = Resources.planejamento_gerado,
        confirmaLimpar = Resources.confirma_limpar,
        limpar = Resources.limpar,
        planejados = Resources.planejados,
        atrasados = Resources.atrasados,
        para_hoje = Resources.para_hoje,
        concluidos = Resources.concluidos,
        podeInserir = (bool)ViewBag.inserir,
        urlCalendario = Url.Action("LoadAgendaCalendario", "Tudo"),
        urlGerar = Url.Action("GerarAgenda", "Tudo"),
        urlLimpar = Url.Action("LimparAgenda", "Tudo"),
        urlApontamento = Url.Action("ChecklistTudoApontamento", "Tudo")
    }))'>
</div>

@section scripts {
    @Scripts.Render("~/plugins/select")
    @Scripts.Render("~/plugins/calendar")
    <script src="~/Content/js/pages/Tudo/jquery.agendaTudo.init.js"></script>
}
